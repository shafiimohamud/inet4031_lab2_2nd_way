# Copy this file to .env.local and fill in real values. Never commit .env.local
# (it is already in .gitignore) and never commit real secrets anywhere else.

# ---- Public site settings --------------------------------------------------
# These start with NEXT_PUBLIC_ because the browser needs to read them too
# (for the tap-to-call link, the footer, etc.). Do not put secrets here.

# The phone number riders and dispatch call. Any common US format works.
NEXT_PUBLIC_PHONE="952-555-0123"

# The inbox the Contact page points people to, and the reply-to address used
# if a rider gives their email (see RESEND_FROM/DISPATCH_EMAIL below for the
# address that actually RECEIVES new ride requests).
NEXT_PUBLIC_CONTACT_EMAIL="dispatch@example.com"

# Shown in the header and footer. Leave unset to hide the hours line
# entirely rather than show a guess.
NEXT_PUBLIC_HOURS="Monday to Friday, 6 am to 6 pm"

# The site's real public URL, no trailing slash. Used in the sitemap,
# canonical links, and structured data. Set this to the real domain before
# launch (for example https://lakeboundmn.com).
NEXT_PUBLIC_SITE_URL="https://lakeboundmn.com"

# "1" shows the yellow VERIFY and "needs your input" notes described in
# src/lib/site.ts. Leave unset in production (it then follows NODE_ENV, i.e.
# off for `next build`/`next start`, on for `next dev`). Set to "0" to force
# it off even in development, once you want to see the site as a visitor would.
# NEXT_PUBLIC_REVIEW_MODE="1"

# ---- Ride request email (server-side only; never exposed to the browser) --
# All three must be set for the ride request form to actually send email.
# Without them, the form fails loudly in production (it will NOT pretend to
# succeed), but in development it logs a warning and pretends to succeed, so
# you can try the form without setting these up yet.

# Create a free account at https://resend.com, verify your sending domain
# there (SPF/DKIM/DMARC), and create an API key.
RESEND_API_KEY=""

# Must be an address at your verified Resend domain, for example
# "Lakebound Transportation <dispatch@lakeboundmn.com>".
RESEND_FROM=""

# Where new ride requests are sent. This can be the same inbox as
# NEXT_PUBLIC_CONTACT_EMAIL, or a dedicated dispatch address.
DISPATCH_EMAIL=""

# Lets the ride request form pretend an unconfigured send succeeded, so you
# can try the whole flow (confirmation screen, reference number) without a
# live Resend account yet. Safe to leave unset: it then already behaves this
# way under `next dev`, and refuses under `next build`+`next start`.
# NEVER set this on a real, live deployment — every ride request would
# silently vanish instead of reaching dispatch.
# ALLOW_SIMULATED_EMAIL="1"
